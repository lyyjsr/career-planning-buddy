# Application
APP_ENV=local
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local PostgreSQL 16 + pgvector
POSTGRES_DB=career_buddy
POSTGRES_USER=career_buddy
POSTGRES_PASSWORD=career_buddy_local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://career_buddy:career_buddy_local@localhost:5432/career_buddy

# Guest JWT. Replace this non-production placeholder before deployment.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440

# Stage 6B Agent Runtime. APP_GIT_COMMIT is injected by CI; local Git is best-effort.
APP_GIT_COMMIT=
AGENT_GRAPH_VERSION=stage6b-v1
AGENT_FEATURE_STAGE=6
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
EVAL_PROVIDER_MODE=mock
EVAL_LIVE_MAX_ATTEMPTS=3
EVAL_LIVE_RETRY_BASE_SECONDS=1
EVAL_LIVE_RETRY_MAX_SECONDS=8
EVAL_LIVE_CONCURRENCY=2
EVAL_LIVE_PACING_SECONDS=0.5

JUDGE_LLM_PROVIDER=fixture
JUDGE_LLM_API_KEY=
JUDGE_LLM_BASE_URL=
JUDGE_LLM_MODEL=
JUDGE_LLM_TIMEOUT_SECONDS=60
JUDGE_LLM_MAX_OUTPUT_TOKENS=4096
JUDGE_LLM_TEMPERATURE=0
SEARCH_PROVIDER=mock

BAIDU_SEARCH_API_KEY=
BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
BAIDU_SEARCH_EDITION=lite
BAIDU_SEARCH_MAX_RESULTS=5
BAIDU_SEARCH_TIMEOUT_SECONDS=10

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL_NAME=
EMBEDDING_DIM=1024
MEMORY_SEMANTIC_RETRIEVAL_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_CONTEXT_MAX_ITEMS=5
MEMORY_CONTEXT_MAX_CHARS=1200
MEMORY_MIN_SIMILARITY=0.35
MEMORY_RECENCY_HALF_LIFE_DAYS=14
RAG_MIN_SIMILARITY=0.35
TOOL_TIMEOUT_SECONDS=8
AGENT_MAX_LLM_CALLS=7
AGENT_MAX_TOOL_ROUNDS=2
AGENT_MAX_TOOL_CALLS=4
AGENT_MAX_TOTAL_TOKENS=16000
AGENT_MAX_INPUT_TOKENS_PER_CALL=6000
AGENT_MAX_OUTPUT_TOKENS_PER_CALL=1500
AGENT_DEADLINE_SECONDS=45

# Docker Compose uses Mock by default even when local runtime variables use real Providers.
# Opt in explicitly only when the model is reachable from inside the container.
COMPOSE_APP_ENV=development
COMPOSE_APP_GIT_COMMIT=unknown
COMPOSE_LLM_PROVIDER=mock
COMPOSE_LLM_API_KEY=
COMPOSE_LLM_BASE_URL=
COMPOSE_LLM_MODEL=
COMPOSE_EMBEDDING_PROVIDER=mock
COMPOSE_EMBEDDING_MODEL_PATH=
COMPOSE_EMBEDDING_MODEL_NAME=
COMPOSE_SEARCH_PROVIDER=mock
COMPOSE_BAIDU_SEARCH_API_KEY=
COMPOSE_BAIDU_SEARCH_BASE_URL=https://qianfan.baidubce.com/v2/ai_search/web_search
COMPOSE_BAIDU_SEARCH_EDITION=lite
COMPOSE_BAIDU_SEARCH_MAX_RESULTS=5
COMPOSE_BAIDU_SEARCH_TIMEOUT_SECONDS=10

# Public browser configuration. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:8000
